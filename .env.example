FLASK_ENV=development
SCANSTORY_DEV_TESTING=0
SCANSTORY_TESTING=0
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/scanstory_dev
TEST_DATABASE_URL=sqlite:///instance/scanstory-test.db
UPLOAD_FOLDER=static/uploads

# Maintained development/QA/production runtime uses PostgreSQL plus Redis/RQ.
# SQLite is supported only for isolated tests that explicitly set
# SCANSTORY_TESTING=1 and TEST_DATABASE_URL.
# Do not commit real passwords or production database names.
#
# SCANSTORY_DEV_TESTING enables disposable local entitlement/test accounts only.
# It must remain 0 in production.

# Queue modes supported by processing_queue.py:
# - fake: no Redis, creates ProcessingJob rows for isolated tests
# - inline: runs processing in-process for disposable local debugging
# - rq: real Redis/RQ worker mode for full integration development and production
# Production startup rejects fake/inline and requires REDIS_URL.
REDIS_URL=
SCANSTORY_QUEUE_MODE=fake
RQ_QUEUE_NAME=scanstory-processing
RQ_DEFAULT_TIMEOUT=600

# Resumable uploads are sent in bounded chunks. Keep this aligned with the
# browser chunk size and configure the reverse proxy to allow at least this
# request body size on /api/uploads/sessions/*/chunk.
SCANSTORY_RESUMABLE_CHUNK_MAX_BYTES=1048576

# Whole-request ingest cap. As of Wave 1 this is ALWAYS set: when the variable
# is left unset the app derives a finite absolute ceiling from the real per-file
# limits, ((MAX_VIDEO_UPLOAD_BYTES + MAX_IMAGE_UPLOAD_BYTES) x
# MAX_PAIRS_PER_PROJECT_CEILING) + 8 MiB, so a legitimate multi-pair upload
# still fits while absolute ingest is never unbounded. Override only to lower
# it deliberately, and keep it >= the reverse proxy's client_max_body_size.
# MAX_CONTENT_LENGTH=11270094848

# Hard ceiling on pairs-per-project used only to size the cap above. Raise it
# only together with the proxy body limit.
MAX_PAIRS_PER_PROJECT_CEILING=10

# Per-request cap applied to every endpoint that is NOT a multi-pair upload
# route (/upload, /projects/<id>/edit, /admin/projects/upload). Oversized
# bodies are rejected with 413 before any parsing or disk spooling.
MAX_REQUEST_BODY_BYTES=67108864

# Shared rate limiting. REQUIRED for multi-worker (gunicorn -w N) production:
# without it every published limit is silently multiplied by the worker count
# and is reset by every rolling restart. When set, the limiter FAILS CLOSED if
# Redis is unreachable.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# Add-on catalogue bootstrap input for `flask seed-addon-catalog`. Prices and
# quantities are a commercial decision and are never defaulted by the app.
# ADDON_CATALOG_SEED_FILE=/etc/scanstory/addon-catalog.json

# DISPOSABLE PostgreSQL database for the additive migrated-schema test lane
# (tests/migrations/test_migrated_schema_lane.py). Never point this at
# production: the lane drops and recreates the schema.
# SCANSTORY_QA_DATABASE_URL=postgresql://qa:qa@localhost:5432/scanstory_qa

# Debug/reloader are OFF unless explicitly enabled. Never set this to 1 in production.
FLASK_DEBUG=0

# Session cookie Secure flag. Leave 0 for local HTTP development; set to 1
# in production over HTTPS.
SESSION_COOKIE_SECURE=0

# SMTP email delivery is required for production OTP verification and
# password reset. Values below are placeholders only; never commit real
# credentials. SMTP_TIMEOUT_SECONDS must be a positive finite number.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
SMTP_TIMEOUT_SECONDS=10
# starttls: connect plain, then upgrade with STARTTLS (typical port 587)
# ssl: connect with implicit TLS (typical port 465)
# none: no transport encryption; local/dev-only unless explicitly approved
SMTP_SECURITY=starttls

# Bootstrap admin creation is OFF (0) by default and must stay OFF on every
# normal boot, including production, once an administrator already exists.
# There is no default Super Admin account and no default password.
#
# Set BOOTSTRAP_ADMIN_ENABLED=1 with real values ONLY for the first startup
# on a brand-new database. Log in once, verify the administrator account,
# and then set BOOTSTRAP_ADMIN_ENABLED=0 again.
#
# When enabled, both email and password are required. The password must be
# at least 8 characters, is never printed or logged, and an existing
# administrator is never overwritten or duplicated.
#
# The values below are placeholders only. Never commit a real email or a
# reusable password. See README.md "First-time Super Admin setup".
BOOTSTRAP_ADMIN_ENABLED=0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Content-Security-Policy rollout.
#
# Development/test may run report-only while browser QA is in progress. A
# production-flagged runtime enforces CSP by default and rejects explicit
# SECURITY_CSP_ENABLED=0 or SECURITY_CSP_ENFORCE=0.
#
# SECURITY_CSP_ENABLED=0 disables both CSP headers in non-production only.
SECURITY_CSP_ENABLED=1
SECURITY_CSP_ENFORCE=0

# HSTS is OFF by default and is sent only over a genuinely HTTPS request.
#
# Enable this only after confirming that the deployment uses working HTTPS
# end-to-end. Enabling HSTS on a plain-HTTP or incorrectly proxied deployment
# can cause browsers to refuse access for the configured max-age period.
SECURITY_HSTS_ENABLED=0

# Project media upload limits (P0D).
#
# Images accept JPEG and PNG only. Videos accept MP4 only.
# Files are validated from their actual content using magic-byte checks,
# Pillow decoding for images, and OpenCV stream/frame probing for videos.
# Client filenames and browser-provided MIME types are not trusted alone.
MAX_IMAGE_UPLOAD_BYTES=52428800
MAX_VIDEO_UPLOAD_BYTES=1073741824
MAX_IMAGE_DIMENSION_PX=8000
MAX_IMAGE_PIXELS=40000000

# Optional maximum video duration in seconds.
# A value of 0 disables video-duration enforcement.
MAX_VIDEO_DURATION_SECONDS=0

# OTP abuse-protection defaults (P0E).
#
# These values control OTP expiry, failed verification attempts, challenge
# lockout, resend throttling, and basic IP-window protections.
# These are operational settings only and contain no secrets.
SCANSTORY_OTP_EXPIRY_SECONDS=120
SCANSTORY_OTP_MAX_VERIFY_ATTEMPTS=5
SCANSTORY_OTP_LOCK_SECONDS=900
SCANSTORY_OTP_RESEND_MIN_INTERVAL_SECONDS=60
SCANSTORY_OTP_MAX_RESENDS=3
SCANSTORY_OTP_RESEND_WINDOW_SECONDS=900
SCANSTORY_OTP_IP_ATTEMPT_LIMIT=30
SCANSTORY_OTP_IP_RESEND_LIMIT=10

# Razorpay payment configuration. Required in production: missing values cause
# startup validation to fail before the deployment can look ready while payments
# are disabled. Values below are placeholders only - never commit real keys.
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# Razorpay webhook signature secret (Dashboard > Webhooks > your configured
# endpoint). REQUIRED for /webhooks/razorpay production certification - this
# is a separate secret from RAZORPAY_KEY_SECRET (the API key pair used to
# call the Razorpay API); it is never the same value and has no fallback.
# When unset, the webhook route fails closed (rejects every request,
# processes nothing) rather than skipping signature verification.
# The value below is a placeholder only - never commit a real webhook secret.
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
