FLASK_ENV=development
SCANSTORY_DEV_TESTING=0
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=replace-with-local-database-url
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=104857600

# Debug/reloader are OFF unless explicitly enabled. Never set this to 1 in production.
FLASK_DEBUG=0

# Session cookie Secure flag. Leave 0 for local HTTP development; set to 1
# in production (HTTPS).
SESSION_COOKIE_SECURE=0

# Bootstrap admin creation is OFF (0) by default and must stay OFF on every
# normal boot, including production, once an administrator already exists.
# There is no default Super Admin account and no default password - set
# BOOTSTRAP_ADMIN_ENABLED=1 with real values ONLY for the first startup on a
# brand-new database, log in once, then set BOOTSTRAP_ADMIN_ENABLED=0 again.
# When enabled, both email and password are required, the password must be
# at least 8 characters, it is never printed/logged, and an existing
# administrator is never overwritten or duplicated.
# The values below are placeholders only - never commit a real email or a
# reusable password. See README.md "First-time Super Admin setup".
BOOTSTRAP_ADMIN_ENABLED=0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Content-Security-Policy staged rollout. Defaults to report-only: the
# browser reports violations to the console but blocks nothing. Only set
# SECURITY_CSP_ENFORCE=1 after browser + real-device QA has confirmed the
# policy doesn't block the scanner, OpenCV/WASM, Razorpay, reCAPTCHA,
# Bootstrap/Chart.js, fonts, or any current inline script/style.
# SECURITY_CSP_ENABLED=0 disables both CSP headers entirely.
SECURITY_CSP_ENABLED=1
SECURITY_CSP_ENFORCE=0

# HSTS is OFF by default and only ever sent over a genuinely HTTPS request.
# Enable only once this deployment is verified to sit behind real, working
# HTTPS end-to-end - enabling it in front of plain HTTP can lock browsers
# out of the site for the max-age duration.
SECURITY_HSTS_ENABLED=0
