FLASK_ENV=development
SCANSTORY_DEV_TESTING=0
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=replace-with-local-database-url
UPLOAD_FOLDER=static/uploads

# Optional whole-request body cap (all files + form fields combined). Unset
# by default - a single legitimate multi-pair project upload can approach
# MAX_VIDEO_UPLOAD_BYTES x pairs-per-project, so only set this if you want
# an explicit outer bound; size it well above that product or large
# uploads will be rejected before per-file validation ever runs.
# MAX_CONTENT_LENGTH=104857600

# Debug/reloader are OFF unless explicitly enabled. Never set this to 1 in production.
FLASK_DEBUG=0

# Session cookie Secure flag. Leave 0 for local HTTP development; set to 1
# in production over HTTPS.
SESSION_COOKIE_SECURE=0

# Bootstrap admin creation is OFF (0) by default and must stay OFF on every
# normal boot, including production, once an administrator already exists.
# There is no default Super Admin account and no default password.
#
# Set BOOTSTRAP_ADMIN_ENABLED=1 with real values ONLY for the first startup
# on a brand-new database. Log in once, verify the administrator account,
# and then set BOOTSTRAP_ADMIN_ENABLED=0 again.
#
# When enabled, both email and password are required. The password must be
# at least 8 characters, is never printed or logged, and an existing
# administrator is never overwritten or duplicated.
#
# The values below are placeholders only. Never commit a real email or a
# reusable password. See README.md "First-time Super Admin setup".
BOOTSTRAP_ADMIN_ENABLED=0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Content-Security-Policy staged rollout.
#
# The default is report-only: the browser reports policy violations but does
# not block resources. Set SECURITY_CSP_ENFORCE=1 only after browser and
# real-device QA confirms the policy does not block the scanner, OpenCV/WASM,
# Razorpay, reCAPTCHA, Bootstrap, Chart.js, fonts, or required inline assets.
#
# SECURITY_CSP_ENABLED=0 disables both CSP headers.
SECURITY_CSP_ENABLED=1
SECURITY_CSP_ENFORCE=0

# HSTS is OFF by default and is sent only over a genuinely HTTPS request.
#
# Enable this only after confirming that the deployment uses working HTTPS
# end-to-end. Enabling HSTS on a plain-HTTP or incorrectly proxied deployment
# can cause browsers to refuse access for the configured max-age period.
SECURITY_HSTS_ENABLED=0

# Project media upload limits (P0D).
#
# Images accept JPEG and PNG only. Videos accept MP4 only.
# Files are validated from their actual content using magic-byte checks,
# Pillow decoding for images, and OpenCV stream/frame probing for videos.
# Client filenames and browser-provided MIME types are not trusted alone.
MAX_IMAGE_UPLOAD_BYTES=52428800
MAX_VIDEO_UPLOAD_BYTES=1073741824
MAX_IMAGE_DIMENSION_PX=8000
MAX_IMAGE_PIXELS=40000000

# Optional maximum video duration in seconds.
# A value of 0 disables video-duration enforcement.
MAX_VIDEO_DURATION_SECONDS=0

# OTP abuse-protection defaults (P0E).
#
# These values control OTP expiry, failed verification attempts, challenge
# lockout, resend throttling, and basic IP-window protections.
# These are operational settings only and contain no secrets.
SCANSTORY_OTP_EXPIRY_SECONDS=120
SCANSTORY_OTP_MAX_VERIFY_ATTEMPTS=5
SCANSTORY_OTP_LOCK_SECONDS=900
SCANSTORY_OTP_RESEND_MIN_INTERVAL_SECONDS=60
SCANSTORY_OTP_MAX_RESENDS=3
SCANSTORY_OTP_RESEND_WINDOW_SECONDS=900
SCANSTORY_OTP_IP_ATTEMPT_LIMIT=30
SCANSTORY_OTP_IP_RESEND_LIMIT=10