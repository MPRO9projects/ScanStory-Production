FLASK_ENV=development
SCANSTORY_DEV_TESTING=0
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=replace-with-local-database-url
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=104857600

# Debug/reloader are OFF unless explicitly enabled. Never set this to 1 in production.
FLASK_DEBUG=0

# Session cookie Secure flag. Leave 0 for local HTTP development; set to 1
# in production (HTTPS).
SESSION_COOKIE_SECURE=0

# Bootstrap admin creation is OFF unless explicitly enabled. Leave unset/0 on
# every normal boot (including production) once an admin already exists.
# When enabling, both email and password are required (password must be at
# least 8 characters); no default credentials are ever used.
BOOTSTRAP_ADMIN_ENABLED=0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
